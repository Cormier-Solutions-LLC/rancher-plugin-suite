{
  "name": "rancher-plugin-suite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "preview": "node scripts/preview-suite.mjs",
    "review:ui": "node scripts/review-ui.mjs",
    "test:ui-review": "node --test scripts/tests/ui-review.test.mjs",
    "test:preview-data": "node --test preview-data/tests/*.test.mjs",
    "test:service-health": "node --test scripts/tests/service-health.test.mjs",
    "test:public-edge": "node scripts/test-public-manager-edge.mjs",
    "test:public-access": "node scripts/test-public-edge.mjs",
    "test:public-access-live": "node scripts/verify-public-edge-live.mjs",
    "publish:public-access-chart": "node scripts/publish-public-edge-chart.mjs",
    "test:dhcp-cutover": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-managed-dns-dhcp-cutover.ps1",
    "build:common-ui": "npm --prefix rancher-common-ui run build",
    "test:common-ui": "npm --prefix rancher-common-ui test",
    "prepreview": "npm run build:common-ui"
  }
}
