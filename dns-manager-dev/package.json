{
  "name": "dns-manager-dev",
  "version": "0.1.31",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "preview": "vite",
    "build:preview": "vite build",
    "build:extension": "node scripts/build-extension.cjs",
    "preview:backups": "node scripts/preview-backups.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:snapshots": "node --test ../preview-data/tests/snapshot-server.test.mjs ../preview-data/tests/snapshot-unlock.test.mjs",
    "test:ui": "vitest run",
    "test:ui:gaps": "vitest run --mode gaps",
    "preview:audit": "vite --config scripts/audit-preview.config.mjs",
    "audit:requirements": "node scripts/audit-requirements.mjs",
    "prepreview": "node ../scripts/ensure-common-ui.mjs",
    "prebuild:preview": "node ../scripts/ensure-common-ui.mjs"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.23.0",
    "lucide": "1.55.0",
    "vue": "3.5.29"
  },
  "devDependencies": {
    "@rancher/shell": "3.0.13",
    "@testing-library/dom": "10.4.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.2",
    "ts-loader": "9.5.4",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "webpack": "5.111.1"
  }
}
