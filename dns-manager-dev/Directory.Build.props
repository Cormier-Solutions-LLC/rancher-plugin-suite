<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TechnitiumLibraryDirectory>$(MSBuildThisFileDirectory)..\.local\dns-prototype\lib</TechnitiumLibraryDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="DnsServerCore.ApplicationCommon">
      <HintPath>$(TechnitiumLibraryDirectory)\DnsServerCore.ApplicationCommon.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TechnitiumLibrary">
      <HintPath>$(TechnitiumLibraryDirectory)\TechnitiumLibrary.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TechnitiumLibrary.Net">
      <HintPath>$(TechnitiumLibraryDirectory)\TechnitiumLibrary.Net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TechnitiumLibrary.IO">
      <HintPath>$(TechnitiumLibraryDirectory)\TechnitiumLibrary.IO.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
