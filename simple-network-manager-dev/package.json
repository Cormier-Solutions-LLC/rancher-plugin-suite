{
  "name": "simple-network-manager-dev",
  "version": "0.1.26",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@rancher/shell": "3.0.13",
    "@zip.js/zip.js": "2.23.0"
  },
  "resolutions": {
    "@types/node": "~25.3.0",
    "@types/lodash": "4.17.5"
  },
  "scripts": {
    "dev": "NODE_ENV=dev ./node_modules/.bin/vue-cli-service serve",
    "build": "./node_modules/.bin/vue-cli-service build",
    "clean": "./node_modules/@rancher/shell/scripts/clean",
    "build-pkg": "./node_modules/@rancher/shell/scripts/build-pkg.sh",
    "serve-pkgs": "./node_modules/@rancher/shell/scripts/serve-pkgs",
    "publish-pkgs": "./node_modules/@rancher/shell/scripts/extension/publish",
    "parse-tag-name": "./node_modules/@rancher/shell/scripts/extension/parse-tag-name",
    "preview": "vite",
    "build:preview": "vite build",
    "build:extension": "node scripts/build-extension.cjs",
    "test:configuration": "node scripts/test-config.mjs",
    "test:snapshots": "node --test ../preview-data/tests/snapshot-server.test.mjs ../preview-data/tests/snapshot-unlock.test.mjs",
    "test:ui:contracts": "node --test tests/ui/layout-contract.test.mjs",
    "test:ui:audit": "node --test tests/ui/recorded-audit.test.mjs",
    "test:audit:snapshots": "node --test tests/ui/snapshot-requirements.audit.test.mjs",
    "prepreview": "node ../scripts/ensure-common-ui.mjs",
    "prebuild:preview": "node ../scripts/ensure-common-ui.mjs"
  },
  "private": true,
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/cli-plugin-typescript": "5.0.8",
    "ts-loader": "9.5.4",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "webpack": "5.111.1"
  }
}
