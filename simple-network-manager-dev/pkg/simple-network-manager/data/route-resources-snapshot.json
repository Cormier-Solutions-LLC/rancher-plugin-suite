    {
      "apiVersion": "traefik.io/v1alpha1",
      "kind": "IngressRoute",
      "metadata": {
        "name": "prod-realtime-gateway",
        "namespace": "prod-realtime"
      },
      "spec": {
        "entryPoints": [
          "websecure"
        ],
        "routes": [
          {
            "kind": "Rule",
            "match": "Host(`gateway.cormierconsulting.io`) && Path(`/realtime/tickets`)",
            "services": [
              {
                "name": "prod-realtime-gateway",
                "port": "http",
                "responseForwarding": {
                  "flushInterval": "-1ms"
                }
              }
            ]
          },
          {
            "kind": "Rule",
            "match": "Host(`gateway.cormierconsulting.io`) && Path(`/realtime/ws`)",
            "services": [
              {
                "name": "prod-realtime-gateway",
                "port": "http",
                "responseForwarding": {
                  "flushInterval": "-1ms"
                }
              }
            ]
          }
        ],
        "tls": {
          "secretName": "gateway-cormierconsulting-io-tls"
        }
      }
    },
