{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["publicHosts", "replicaCount", "image", "service", "upstream", "certificate", "resources"],
  "properties": {
    "global": { "type": "object" },
    "publicHosts": {
      "type": "array", "maxItems": 50, "uniqueItems": true,
      "items": { "type": "string", "maxLength": 253, "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$" }
    },
    "replicaCount": { "type": "integer", "minimum": 2, "maximum": 10 },
    "image": { "type": "string", "pattern": "^nginx@sha256:[a-f0-9]{64}$" },
    "service": {
      "type": "object", "additionalProperties": false, "required": ["type", "loadBalancerIP"],
      "properties": {
        "type": { "enum": ["ClusterIP", "LoadBalancer"] },
        "loadBalancerIP": { "type": "string", "pattern": "^(|(?:[0-9]{1,3}\\.){3}[0-9]{1,3})$" }
      }
    },
    "upstream": {
      "type": "object", "additionalProperties": false, "required": ["host", "port", "caBundle"],
      "properties": {
        "host": { "type": "string", "pattern": "^[a-zA-Z0-9.-]+$" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "caBundle": { "type": "string", "pattern": "^/[a-zA-Z0-9/_.-]+$" }
      }
    },
    "certificate": {
      "type": "object", "additionalProperties": false, "required": ["issuerName", "secretName"],
      "properties": {
        "issuerName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
        "secretName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" }
      }
    },
    "resources": { "type": "object" }
  }
}
